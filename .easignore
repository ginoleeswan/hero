# .easignore — what EAS Build does NOT need uploaded.
#
# ─── READ THIS BEFORE EDITING ────────────────────────────────────────────────
# EAS uses this file INSTEAD OF .gitignore, not in addition to it. The moment
# this file exists, every .gitignore rule stops applying to the build archive —
# so the whole of .gitignore is reproduced below. Deleting a line here can make
# the upload BIGGER, and can leak a local-only file (keys, .env.local) into the
# archive. When you add a rule to .gitignore, add it here too.
#
# The first upload was 161 MB. Everything excluded below is either already
# gitignored, or was verified unreferenced by `src/`, `app/`, `plugins/` and
# `app.config.ts` before being added — a build needs the app and its assets,
# not the marketing output or the tooling that made it.
#
# NOT excluded, deliberately:
#   assets/       every subdirectory except silhouettes is imported by app
#                 code (images by 6 files, brands by 2, avatars by 1, fonts by
#                 3). ~4 MB of unreferenced art is not worth a broken bundle.
#   plugins/      app.config.ts loads ./plugins/withAndroidIconPadding.
#   android/      needed for Android builds from this same archive.

# ── Not needed by a build (verified unreferenced by app code) ────────────────

# App Store marketing output: captures + generated screenshots. Produced BY
# the app, never consumed by it.
#
# NOTE: this rule only removes store/ from the archive if the files are also
# untracked. Measured on the first two uploads — EAS enumerates the project
# through git, so .easignore suppresses UNTRACKED files but does not drop
# content that is committed. Tracked total was 96.7 MB against a 101.8 MB
# archive; store/ was listed here and survived anyway. That is why
# store/screenshots/ is gitignored rather than only listed here.
store/

# Documentation, including ~170 dated design specs.
docs/

# Tests never run on the build machine.
__tests__/
jest.config.js
jest.setup.js

# SQL migrations and edge functions deploy via the Supabase CLI, not EAS.
supabase/

# Web-only static files; the native build has no use for them.
public/

# Tooling. scripts/social alone is 8 MB of brand/social generators. Nothing in
# here runs during an EAS build: the only build hooks are `prepare`
# (git config) and `eas-build-pre-install` (corepack enable).
scripts/

# Repo history. Larger than the entire working tree (241 MB) and never needed
# to compile the app.
.git/
.github/
.githooks/

# Local agent/session scratch.
.superpowers/
.worktrees/
.claude/

# ── Everything below mirrors .gitignore ─────────────────────────────────────
# Keep in sync. See the warning at the top of this file.

node_modules/
.expo/
.env.local
.env*.local
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
dist/

# macOS
.DS_Store

# Xcode
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
project.xcworkspace

# Android/IntelliJ
.idea
.gradle
local.properties
*.iml
*.hprof

# node
npm-debug.log
yarn-error.log
.yarn/install-state.gz
.yarn/build-state.yml

# BUCK
buck-out/
\.buckd/
*.keystore
!debug.keystore

# Bundle artifacts
*.jsbundle

# CocoaPods
/ios/Pods/

expo-env.d.ts

# iOS native is regenerated by prebuild on the build machine.
/ios
ios/Pods/
ios/build/

# Android build output (the android/ SOURCE is kept — see the header).
android/.gradle/
android/app/build/
android/build/

# Playwright MCP artifacts
.playwright-mcp/

# Contains an inline secret — never upload.
scripts/cloudinary-onboarding.js

# Local-only working directories.
portrait-backup/
supabase/.temp/
/.ds-sync/
/.ds-pkg/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
reference-portraits/
out/
assets/silhouettes/raw/
scripts/design-audit/history/
