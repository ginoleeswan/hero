{
  "name": "mythique",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "update:dev": "APP_VARIANT=development eas update --branch development --environment development --platform ios --auto",
    "test": "jest --watchAll",
    "test:ci": "jest --ci",
    "test:social": "node --test \"scripts/social/**/*.test.mjs\"",
    "smoke": "node scripts/smoke/e2e-smoke.mjs",
    "docs:links": "node scripts/docs/check-doc-links.mjs",
    "social": "node scripts/social/studio.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "eas-build-pre-install": "corepack enable && yarn set version 4"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/righteous": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.110.6",
    "@tanstack/react-query": "5.101.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "base64-arraybuffer": "^1.0.2",
    "d3-hierarchy": "^3.1.2",
    "dotenv": "17.4.2",
    "expo": "~56.0.16",
    "expo-apple-authentication": "~56.0.4",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.23",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.23",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.21",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-router": "~56.2.15",
    "expo-sharing": "~56.0.22",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.22",
    "expo-web-browser": "~56.0.5",
    "node-addon-api": "8.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-circular-progress": "^1.4.1",
    "react-native-figma-squircle": "^0.4.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-image-viewing": "^0.2.2",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.3.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-touchable-scale": "^2.2.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "sharp": "0.35.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2",
    "@types/sharp": "^0.32.0",
    "@types/three": "^0.185.0",
    "cloudinary": "^2.10.0",
    "eslint": "^10.6.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.2.1",
    "jest-expo": "~56.0.5",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.4",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "packageManager": "yarn@4.15.0",
  "resolutions": {
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.env.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-reanimated|d3-hierarchy)"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "moduleNameMapper": {
      "^react-native-reanimated/mock$": "<rootDir>/__mocks__/react-native-reanimated-mock-shim.js",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^@sentry/react-native$": "<rootDir>/__mocks__/@sentry/react-native.js",
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js",
      "^(\\.{1,2}/.*)\\.ts$": "$1"
    }
  }
}
