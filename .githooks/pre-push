#!/bin/sh
# Fast local gate before code leaves your machine — mirrors the cheap CI
# checks so you find breakage in seconds, not via a red badge you'll ignore.
# Wired by the package.json "prepare" script (git config core.hooksPath
# .githooks). Skip a one-off push with: git push --no-verify
set -e

echo "pre-push: format:check + typecheck + lint…"
# Use yarn if its node_modules state is available; fall back to npm run in
# environments where yarn can't install (e.g. CI containers with no registry
# access) — the checks are identical either way.
if yarn format:check 2>/dev/null; then
  yarn typecheck
  yarn lint
else
  echo "pre-push: yarn unavailable, falling back to npm run"
  npm run format:check
  npm run typecheck
  npm run lint
fi
echo "pre-push: ok"
